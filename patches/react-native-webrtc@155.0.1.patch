diff --git a/android/src/main/java/com/oney/WebRTCModule/KeepaliveCaptureController.java b/android/src/main/java/com/oney/WebRTCModule/KeepaliveCaptureController.java
new file mode 100644
index 0000000000000000000000000000000000000000..befd4dee041f767224324160dbec6557b848c8ef
--- /dev/null
+++ b/android/src/main/java/com/oney/WebRTCModule/KeepaliveCaptureController.java
@@ -0,0 +1,131 @@
+package com.oney.WebRTCModule;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.SystemClock;
+
+import com.facebook.react.bridge.ReadableMap;
+
+import org.webrtc.CapturerObserver;
+import org.webrtc.JavaI420Buffer;
+import org.webrtc.SurfaceTextureHelper;
+import org.webrtc.ThreadUtils;
+import org.webrtc.VideoCapturer;
+import org.webrtc.VideoFrame;
+
+import java.nio.ByteBuffer;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Yap: a video source that sends one small black frame per second and opens
+ * no camera. A camera or screen share that is turned off keeps its sender
+ * (and its SFU track) on this until it is turned on again; the SFU drops a
+ * pushed track that receives no media for 30 s. Requested through
+ * getUserMedia with video.deviceId == DEVICE_ID (no permission is needed).
+ */
+class KeepaliveCaptureController extends AbstractVideoCaptureController {
+    static final String DEVICE_ID = "yap:video-keepalive";
+    // Multiples of 16, which hardware encoders accept.
+    private static final int WIDTH = 160;
+    private static final int HEIGHT = 96;
+    private static final int FRAME_INTERVAL_MS = 1000;
+
+    KeepaliveCaptureController() {
+        super(WIDTH, HEIGHT, 1);
+    }
+
+    static boolean isRequested(ReadableMap videoConstraints) {
+        return videoConstraints != null && videoConstraints.hasKey("deviceId")
+                && DEVICE_ID.equals(videoConstraints.getString("deviceId"));
+    }
+
+    @Override
+    public String getDeviceId() {
+        return DEVICE_ID;
+    }
+
+    @Override
+    protected VideoCapturer createVideoCapturer() {
+        return new BlackFrameCapturer();
+    }
+
+    private static final class BlackFrameCapturer implements VideoCapturer {
+        private CapturerObserver observer;
+        private Handler handler;
+        private volatile boolean running;
+        private boolean odd;
+
+        private final Runnable tick = new Runnable() {
+            @Override
+            public void run() {
+                if (!running) return;
+                deliverFrame();
+                handler.postDelayed(this, FRAME_INTERVAL_MS);
+            }
+        };
+
+        @Override
+        public void initialize(SurfaceTextureHelper helper, Context context, CapturerObserver capturerObserver) {
+            observer = capturerObserver;
+            handler = helper.getHandler();
+        }
+
+        @Override
+        public void startCapture(int width, int height, int framerate) {
+            handler.post(() -> {
+                if (running) return;
+                running = true;
+                observer.onCapturerStarted(true);
+                tick.run();
+            });
+        }
+
+        @Override
+        public void stopCapture() {
+            ThreadUtils.invokeAtFrontUninterruptibly(handler, () -> {
+                if (!running) return;
+                running = false;
+                handler.removeCallbacks(tick);
+                observer.onCapturerStopped();
+            });
+        }
+
+        @Override
+        public void changeCaptureFormat(int width, int height, int framerate) {}
+
+        @Override
+        public void dispose() {
+            if (handler != null) stopCapture();
+        }
+
+        @Override
+        public boolean isScreencast() {
+            return false;
+        }
+
+        @Override
+        public boolean isCapturing() {
+            return running;
+        }
+
+        private void deliverFrame() {
+            JavaI420Buffer buffer = JavaI420Buffer.allocate(WIDTH, HEIGHT);
+            // Two blacks in turn (limited-range Y 16 and 17), so every frame
+            // is a change the encoder sends.
+            odd = !odd;
+            fill(buffer.getDataY(), (byte) (odd ? 16 : 17));
+            fill(buffer.getDataU(), (byte) 128);
+            fill(buffer.getDataV(), (byte) 128);
+            long timestampNs = TimeUnit.MILLISECONDS.toNanos(SystemClock.elapsedRealtime());
+            VideoFrame frame = new VideoFrame(buffer, 0, timestampNs);
+            observer.onFrameCaptured(frame);
+            frame.release();
+        }
+
+        private static void fill(ByteBuffer plane, byte value) {
+            ByteBuffer target = plane.duplicate();
+            target.clear();
+            while (target.hasRemaining()) target.put(value);
+        }
+    }
+}
