+// Ralph Meet: resolves once a pull may renegotiate. A peer connection that has
+// negotiated nothing yet goes at once (this pull connects it), as does one that
+// has connected before ("disconnected" is an ICE blip on an established
+// session). One that negotiated and is still "new" or "connecting" waits.
+async function peerConnectionIsReadyForPull(peerConnection, timeout = 5e3) {
+	const isReady = () => {
+		const state = peerConnection.connectionState;
+		if (state === "failed" || state === "closed") throw new Error(`PeerConnection connectionState is ${state}`);
+		if (state === "new") return !peerConnection.remoteDescription;
+		return state !== "connecting";
+	};
+	if (isReady()) return;
+	// iceconnectionstatechange too: when ICE fails the session closes the peer
