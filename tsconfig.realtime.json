{
  // The Durable Objects, the Worker entry and their workerd tests, which
  // tsconfig.json does not include. `node` because wrangler.toml sets
  // nodejs_compat. `@cloudflare/vitest-pool-workers/types` declares the
  // `cloudflare:test` module the *.worker.test.ts files import.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "node"
    ]
  },
  "include": [
    "realtime/**/*.ts",
    "custom-server-entry.ts",
    "realtime-test-entry.ts",
    "src/env.d.ts"
  ],
  "exclude": ["node_modules"]
}
