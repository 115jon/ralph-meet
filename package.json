{
  "name": "ralph-meet",
  "version": "1.20.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env CI=true vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "doctor": "react-doctor --project .,desktop,mobile --blocking none -y",
    "doctor:verbose": "react-doctor --project .,desktop,mobile --blocking none --verbose -y",
    "doctor:changed": "react-doctor --project .,desktop,mobile --blocking none --scope changed -y",
    "deploy:do": "wrangler deploy --config worker/wrangler.toml",
    "deploy:main": "vite build && wrangler deploy",
    "deploy": "pnpm run deploy:do && pnpm run deploy:main",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern .github src scripts desktop/desktop-entry.tsx desktop/index.html desktop/styles.css desktop/package.json desktop/tsconfig.json desktop/vite.config.ts mobile/mobile-entry.tsx mobile/index.html mobile/styles.css mobile/package.json mobile/tsconfig.json mobile/vite.config.ts *.json *.js *.mjs *.cjs *.ts *.tsx *.md",
    "format:check": "prettier --check --ignore-unknown --no-error-on-unmatched-pattern .github src scripts desktop/desktop-entry.tsx desktop/index.html desktop/styles.css desktop/package.json desktop/tsconfig.json desktop/vite.config.ts mobile/mobile-entry.tsx mobile/index.html mobile/styles.css mobile/package.json mobile/tsconfig.json mobile/vite.config.ts *.json *.js *.mjs *.cjs *.ts *.tsx *.md",
    "test": "vitest run",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "logs": "node scripts/query-logs.mjs",
    "prepare": "node scripts/copy-mediapipe.mjs && simple-git-hooks",
    "bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@fontsource/bungee": "^5.2.7",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/permanent-marker": "^5.2.7",
    "@fontsource/press-start-2p": "^5.2.7",
    "@fontsource/unifrakturmaguntia": "^5.2.8",
    "@kova/react": "https://github.com/115jon/kova/releases/download/kova-react-v0.1.0/kova-react-0.1.0.tgz",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.163.3",
    "@tanstack/react-start": "^1.164.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.564.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "^19.2.4",
    "react-virtuoso": "^4.18.1",
    "recharts": "^3.7.0",
    "spotify-url-info": "^3.3.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.185.1",
    "virtua": "^0.48.6",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.2",
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "@cloudflare/workers-types": "^4.20260612.1",
    "@eslint/js": "^9.39.3",
    "@tanstack/eslint-plugin-router": "^1.161.4",
    "@tauri-apps/api": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.1.4",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.8.0",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "react-doctor": "^0.5.8",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.1",
    "simple-git-hooks": "^2.11.1",
    "react-scan": "^0.5.7",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-killer-instincts": "^1.0.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.110.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": "prettier --write"
  }
}
