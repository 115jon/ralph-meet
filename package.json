{
  "name": "ralph-meet",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env CI=true RALPH_AUTH=dev vite dev",
    "dev:prod-auth": "cross-env CI=true RALPH_AUTH=prod vite dev --port 5199",
    "build": "vite build",
    "icons:generate": "node scripts/generate-phosphor-icons.mjs",
    "preview": "vite preview",
    "perf": "pnpm run build && lhci autorun",
    "doctor": "react-doctor --project ralph-meet,desktop,mobile --blocking none -y",
    "doctor:verbose": "react-doctor --project ralph-meet,desktop,mobile --blocking none --verbose -y",
    "doctor:changed": "react-doctor --project ralph-meet,desktop,mobile --blocking none --scope changed -y",
    "migrate:main": "wrangler d1 migrations apply ralph-chat-db --remote",
    "deploy:main": "pnpm run migrate:main && vite build && wrangler deploy --env=\"\"",
    "deploy": "pnpm run deploy:main",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.realtime.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "logs": "node scripts/query-logs.mjs",
    "idle-probe": "node scripts/idle-probe.mjs",
    "bench:voice": "node scripts/voice-latency/bench.mjs",
    "bench:voice:verify": "node scripts/voice-latency/verify-standby.mjs",
    "prepare": "node scripts/copy-mediapipe.mjs && (lefthook install || exit 0)",
    "bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@audio/noise-estimate": "^1.0.1",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/bungee": "^5.2.7",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/permanent-marker": "^5.2.7",
    "@fontsource/press-start-2p": "^5.2.7",
    "@fontsource/unifrakturmaguntia": "^5.2.8",
    "@kova/react": "https://github.com/115jon/kova/releases/download/kova-react-v1.2.0/115jon-kova-react-1.2.0.tgz",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@radix-ui/react-focus-scope": "1.1.7",
    "@ricky0123/vad-web": "^0.0.30",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.163.3",
    "@tanstack/react-start": "^1.164.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "ditherwave": "^0.1.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.564.0",
    "next-themes": "^0.4.6",
    "partytracks": "^0.0.56",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "^19.2.4",
    "react-virtuoso": "^4.18.1",
    "recharts": "^3.7.0",
    "rxjs": "^7.8.2",
    "sonner": "^2.0.8",
    "spotify-url-info": "^3.3.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.185.1",
    "virtua": "^0.48.6",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@lhci/cli": "^0.15.1",
    "@oxlint/plugins": "1.85.0",
    "@phosphor-icons/core": "2.1.1",
    "@tanstack/eslint-plugin-router": "^1.161.4",
    "@tauri-apps/api": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.1.4",
    "cross-env": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.71.0",
    "oxlint": "1.85.0",
    "playwright-core": "1.64.1",
    "puppeteer-core": "^25.16.0",
    "react-doctor": "0.9.2",
    "react-scan": "^0.5.7",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7.3.1",
    "vite-plugin-killer-instincts": "^1.0.0",
    "vitest": "^4.1.9",
    "wrangler": "4.110.0"
  }
}
