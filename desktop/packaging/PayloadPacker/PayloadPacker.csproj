<Project Sdk="Microsoft.NET.Sdk">

  <!-- net48 so CI and developers need nothing beyond the SDK the installer already uses. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PayloadPacker</AssemblyName>
    <RootNamespace>PayloadPacker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared"/>
  </ItemGroup>

</Project>
