<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Installer.Ui">

    <!-- The app's three faces (DESIGN.md, Typography), as static Latin instances embedded in
         the exe (Assets/Fonts, SIL OFL 1.1; see docs/desktop/installer-ui.md). Bricolage names
         things, Martian labels and counts things, Geist says things. -->
    <FontFamily x:Key="FontTitle">pack://application:,,,/Assets/Fonts/#RM Bricolage Title, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontKey">pack://application:,,,/Assets/Fonts/#RM Bricolage Key, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontBody">pack://application:,,,/Assets/Fonts/#RM Geist, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontBodyMedium">pack://application:,,,/Assets/Fonts/#RM Geist Medium, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontNum">pack://application:,,,/Assets/Fonts/#RM Martian Num, Cascadia Mono, Consolas</FontFamily>

    <!-- Phosphor (MIT) Bold glyphs on the 256 grid, as the app's Icon adapter draws them idle. -->
    <Geometry x:Key="GlyphX">M208.49,191.51a12,12,0,0,1-17,17L128,145,64.49,208.49a12,12,0,0,1-17-17L111,128,47.51,64.49a12,12,0,0,1,17-17L128,111l63.51-63.52a12,12,0,0,1,17,17L145,128Z</Geometry>
    <Geometry x:Key="GlyphMinus">M228,128a12,12,0,0,1-12,12H40a12,12,0,0,1,0-24H216A12,12,0,0,1,228,128Z</Geometry>
    <Geometry x:Key="GlyphCopy">M216,28H88A12,12,0,0,0,76,40V76H40A12,12,0,0,0,28,88V216a12,12,0,0,0,12,12H168a12,12,0,0,0,12-12V180h36a12,12,0,0,0,12-12V40A12,12,0,0,0,216,28ZM156,204H52V100H156Zm48-48H180V88a12,12,0,0,0-12-12H100V52H204Z</Geometry>
    <Geometry x:Key="GlyphCheck">M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z</Geometry>
    <Geometry x:Key="GlyphFile">M216.49,79.52l-56-56A12,12,0,0,0,152,20H56A20,20,0,0,0,36,40V216a20,20,0,0,0,20,20H200a20,20,0,0,0,20-20V88A12,12,0,0,0,216.49,79.52ZM160,57l23,23H160ZM60,212V44h76V92a12,12,0,0,0,12,12h48V212Zm112-80a12,12,0,0,1-12,12H96a12,12,0,0,1,0-24h64A12,12,0,0,1,172,132Zm0,40a12,12,0,0,1-12,12H96a12,12,0,0,1,0-24h64A12,12,0,0,1,172,172Z</Geometry>

    <Style x:Key="Glyph" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Type: the app's hierarchy, at its sizes. -->
    <Style x:Key="Silk" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SilkFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="LineHeight" Value="14"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
    </Style>
    <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontTitle}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="LineHeight" Value="32"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Message" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Description" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Num" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontNum}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
    </Style>

    <!-- Focus: a 2px accent ring with a 2px offset, drawn at once, keyboard focus only. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" Stroke="{DynamicResource AccentInk}" StrokeThickness="2" RadiusX="2" RadiusY="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keys (ui/button). Squared 2px, Bricolage 600 labels, 48px in a dialog footer. Hover is
         an overlay of the key's own ink (8 percent, 12 on a fill), press 14 and a 0.97 scale. -->
    <Style x:Key="KeyBase" TargetType="Button">
        <Setter Property="Height" Value="48"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="FontFamily" Value="{StaticResource FontKey}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform/>
            </Setter.Value>
        </Setter>
        <Setter Property="Tag" Value="0.08"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
                        <Border x:Name="Hover" Background="{TemplateBinding Foreground}" CornerRadius="2" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.14"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Source={x:Static ui:MotionFlags.Instance}, Path=Enabled}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                    </Setter.Value>
                </Setter>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary beside a primary: C1 key with a 2px ink-1 edge (paired). -->
    <Style x:Key="KeySecondary" TargetType="Button" BasedOn="{StaticResource KeyBase}">
        <Setter Property="BorderBrush" Value="{DynamicResource Ink1}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Danger: solid red, irreversible only (here: removing the app). -->
    <Style x:Key="KeyDanger" TargetType="Button" BasedOn="{StaticResource KeyBase}">
        <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnDanger}"/>
        <Setter Property="Tag" Value="0.12"/>
    </Style>

    <!-- Primary: the C2 notched key. A 10px cut from the top-right corner, painted (not clipped,
         so the focus ring stays whole), and a still dithered cap after the label. One per view. -->
    <Style x:Key="KeyPrimary" TargetType="Button" BasedOn="{StaticResource KeyBase}">
        <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
        <Setter Property="Padding" Value="20,0,12,0"/>
        <Setter Property="Tag" Value="0.12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <Border x:Name="Hover" Background="{TemplateBinding Foreground}" CornerRadius="2" Opacity="0"/>
                        <Path Data="M0,0 L10,0 L10,10 Z" Width="10" Height="10" Fill="{DynamicResource Ply0}"
                              HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <ui:DitherDots Width="12" Height="24" Margin="4,0,0,0" VerticalAlignment="Center"
                                           Ink="{TemplateBinding Foreground}" Visibility="{DynamicResource ShowDither}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.14"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Tint2}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small key inside a plate (32px, ghost, glyph then label). -->
    <Style x:Key="KeySmall" TargetType="Button" BasedOn="{StaticResource KeyBase}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="8,0,10,0"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Window keys in the title bar: 40px squares, a Bold glyph in ink-2, tint-2 on hover. -->
    <Style x:Key="TitleKey" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Tint2}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Tint3}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The meter: an h-1 tint-2 track with an accent fill that grows by scaleX (transform
         only, as the updater's bar does). The indeterminate segment is the one allowed loop,
         run from code only while waiting and only with motion on. -->
    <Style x:Key="Meter" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                        <Border Background="{DynamicResource Tint2}" CornerRadius="2"/>
                        <!-- Their transforms are set from code (template transforms are frozen). -->
                        <Border x:Name="Fill" Background="{DynamicResource AccentInk}" CornerRadius="2" RenderTransformOrigin="0,0.5"/>
                        <Border x:Name="Segment" Background="{DynamicResource AccentInk}" CornerRadius="2" Width="96"
                                HorizontalAlignment="Left" Visibility="Collapsed"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A leaf of the steps tree: 28px row, 1px guide strokes, an 8px tick and a 6px LED. -->
    <Style TargetType="ui:TreeStep">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TreeStep">
                    <Grid SnapsToDevicePixels="True" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Canvas Width="28" Height="28">
                            <Rectangle x:Name="Upper" Canvas.Left="4" Canvas.Top="0" Width="1" Height="14" Fill="{DynamicResource Guide}"/>
                            <Rectangle x:Name="Lower" Canvas.Left="4" Canvas.Top="14" Width="1" Height="14" Fill="{DynamicResource Guide}"/>
                            <Rectangle x:Name="Tick" Canvas.Left="5" Canvas.Top="13" Width="8" Height="1" Fill="{DynamicResource Guide}"/>
                            <Ellipse x:Name="Halo" Canvas.Left="12" Canvas.Top="9" Width="10" Height="10" Fill="{DynamicResource TalkHalo}" Opacity="0"/>
                            <Ellipse x:Name="Led" Canvas.Left="14" Canvas.Top="11" Width="6" Height="6" Fill="{DynamicResource LineStrong}"/>
                        </Canvas>
                        <TextBlock x:Name="Text" Grid.Column="1" Text="{TemplateBinding Label}" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontBodyMedium}" FontWeight="Medium" FontSize="14"
                                   Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLast" Value="True">
                            <Setter TargetName="Lower" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="PathThrough" Value="True">
                            <Setter TargetName="Upper" Property="Fill" Value="{DynamicResource AccentInk}"/>
                            <Setter TargetName="Lower" Property="Fill" Value="{DynamicResource AccentInk}"/>
                        </Trigger>
                        <Trigger Property="State" Value="Active">
                            <Setter TargetName="Upper" Property="Fill" Value="{DynamicResource AccentInk}"/>
                            <Setter TargetName="Tick" Property="Fill" Value="{DynamicResource AccentInk}"/>
                            <Setter TargetName="Led" Property="Fill" Value="{DynamicResource AccentInk}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
                        </Trigger>
                        <Trigger Property="State" Value="Done">
                            <Setter TargetName="Led" Property="Fill" Value="{DynamicResource Talk}"/>
                            <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                        </Trigger>
                        <Trigger Property="State" Value="Failed">
                            <Setter TargetName="Upper" Property="Fill" Value="{DynamicResource AccentInk}"/>
                            <Setter TargetName="Tick" Property="Fill" Value="{DynamicResource AccentInk}"/>
                            <Setter TargetName="Led" Property="Fill" Value="{DynamicResource DangerInk}"/>
                            <Setter TargetName="Halo" Property="Fill" Value="{DynamicResource DangerHalo}"/>
                            <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource DangerInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
