<Window x:Class="Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Installer.Ui"
        Title="Ralph Meet Setup" Width="440" Height="520"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen" Topmost="False" ShowInTaskbar="True"
        Icon="Assets/icon.ico"
        Background="{DynamicResource Ply0}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        AutomationProperties.Name="Ralph Meet Setup">

    <WindowChrome.WindowChrome>
        <!-- Our own title bar: the top 40px drag (and snap) like a native caption. -->
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/LogoGeometry.xaml"/>
                <ResourceDictionary Source="Ui/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Ply-0 canvas with a 1px line-strong edge, squared like every surface in the app. -->
    <Border x:Name="Root" Background="{DynamicResource Ply0}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="WindowLabel" Style="{StaticResource Silk}" Text="RALPH MEET SETUP"
                           VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Ralph Meet Setup"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeKey" Style="{StaticResource TitleKey}" TabIndex="20"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Minimize" ToolTip="Minimize" Click="MinimizeKey_Click">
                        <Path Style="{StaticResource Glyph}" Width="14" Height="14" Data="{StaticResource GlyphMinus}"/>
                    </Button>
                    <Button x:Name="CloseKey" Style="{StaticResource TitleKey}" TabIndex="21"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Close" ToolTip="Close" Click="CloseKey_Click">
                        <Path Style="{StaticResource Glyph}" Width="14" Height="14" Data="{StaticResource GlyphX}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- One screen at a time; a new screen fades in and settles 4px. -->
            <DockPanel x:Name="Screen" Grid.Row="1" Margin="32,8,32,32" LastChildFill="True">
                <DockPanel.RenderTransform>
                    <TranslateTransform x:Name="ScreenSettle"/>
                </DockPanel.RenderTransform>

                <StackPanel DockPanel.Dock="Top">
                    <ui:DitherMark x:Name="Mark" Width="96" Height="96" HorizontalAlignment="Left" Pending="True"
                                   Ink="{DynamicResource AccentInk}" Ground="{DynamicResource Ply0}"
                                   Visibility="{DynamicResource ShowDither}"/>

                    <!-- Kicker: a silkscreen label, or an LED and its status word. -->
                    <StackPanel x:Name="Kicker" Orientation="Horizontal" Margin="0,24,0,0">
                        <Grid x:Name="KickerLed" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Ellipse x:Name="KickerHalo" Width="10" Height="10" Fill="{DynamicResource TalkHalo}"/>
                            <Ellipse x:Name="KickerDot" Width="6" Height="6" Fill="{DynamicResource Talk}"/>
                        </Grid>
                        <TextBlock x:Name="KickerText" Style="{StaticResource Silk}" Text="SETUP" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitle}" Margin="0,8,0,0" Text="Installing Ralph Meet"/>

                    <ScrollViewer x:Name="StatusScroll" Margin="0,8,0,0" MaxHeight="88" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="StatusText" Style="{StaticResource Message}" Text="Getting ready…"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </ScrollViewer>
                </StackPanel>

                <!-- Footer keys: secondary, then the one primary (or danger) key. -->
                <StackPanel x:Name="Footer" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,24,0,0" Visibility="Collapsed">
                    <Button x:Name="SecondaryKey" Style="{StaticResource KeySecondary}" TabIndex="10" Content="Cancel"
                            Margin="0,0,12,0" Click="SecondaryKey_Click"/>
                    <Button x:Name="PrimaryKey" Style="{StaticResource KeyPrimary}" TabIndex="11" Content="Try again"
                            Click="PrimaryKey_Click"/>
                    <Button x:Name="DangerKey" Style="{StaticResource KeyDanger}" TabIndex="11" Content="Uninstall"
                            Visibility="Collapsed" Click="PrimaryKey_Click"/>
                </StackPanel>

                <Grid>
                    <!-- Progress: the meter, its readout, and the steps tree. -->
                    <StackPanel x:Name="ProgressPanel" Margin="0,24,0,0">
                        <ProgressBar x:Name="Meter" Style="{StaticResource Meter}" AutomationProperties.Name="Install progress"/>
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="SizeText" Style="{StaticResource Num}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="PercentText" Style="{StaticResource Num}" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Ink1}"/>
                        </Grid>

                        <StackPanel x:Name="Steps" Margin="0,20,0,0">
                            <Grid Height="24">
                                <TextBlock Style="{StaticResource Silk}" Text="STEPS" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StepCount" Style="{StaticResource Num}" FontSize="11" LineHeight="14"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <Rectangle Width="1" Height="5" Fill="{DynamicResource Guide}" HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom" Margin="4,0,0,0"/>
                            </Grid>
                            <ui:TreeStep x:Name="StepUnpack" Label="Unpack files"/>
                            <ui:TreeStep x:Name="StepSetup" Label="Add shortcuts and links"/>
                            <ui:TreeStep x:Name="StepFinish" Label="Start Ralph Meet" IsLast="True"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Failure: where the log is, and a way to it (C1 legend plate). -->
                    <Grid x:Name="LogPanel" Margin="0,24,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                        <Border Background="{DynamicResource Ply2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                CornerRadius="2" Padding="16,16,8,8" Margin="0,7,0,0">
                            <StackPanel>
                                <TextBox x:Name="LogPathText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                         Margin="-2,0,8,0" TextWrapping="Wrap" FontFamily="{StaticResource FontBody}" FontSize="13"
                                         Foreground="{DynamicResource Ink2}" SelectionBrush="{DynamicResource AccentInk}"
                                         CaretBrush="{DynamicResource AccentInk}" FocusVisualStyle="{x:Null}" TabIndex="12"
                                         AutomationProperties.Name="Installer log path"/>
                                <StackPanel Orientation="Horizontal" Margin="-8,8,0,0">
                                    <Button x:Name="CopyKey" Style="{StaticResource KeySmall}" TabIndex="13" Click="CopyKey_Click"
                                            AutomationProperties.Name="Copy log path">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="CopyGlyph" Style="{StaticResource Glyph}" Data="{StaticResource GlyphCopy}" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="CopyLabel" Text="Copy path" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="OpenLogKey" Style="{StaticResource KeySmall}" TabIndex="14" Margin="4,0,0,0"
                                            Click="OpenLogKey_Click" AutomationProperties.Name="Open log">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Glyph}" Data="{StaticResource GlyphFile}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Open log" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- The legend is printed across the plate's top edge on a backing of the ground. -->
                        <Border Background="{DynamicResource Ply0}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="12,0,0,0" Padding="4,0">
                            <TextBlock Style="{StaticResource Silk}" Text="INSTALLER LOG"/>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
