<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>RalphMeetSetup</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Company>115jon</Company>
    <Product>Ralph Meet Setup</Product>
    <Version>3.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico"/>
    <EmbeddedResource Include="Assets\payload.rmpk" Condition="Exists('Assets\payload.rmpk')"/>
    <!-- LZMA SDK + RMPK container, shared with the payload packer (see docs/desktop/packaging.md). -->
    <Compile Include="..\packaging\Shared\**\*.cs" LinkBase="Shared"/>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization"/>
    <Reference Include="Microsoft.CSharp"/>
  </ItemGroup>

</Project>
