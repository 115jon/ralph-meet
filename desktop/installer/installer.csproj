<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>YapSetup</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Company>115jon</Company>
    <Product>Yap Setup</Product>
    <Version>3.13.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico"/>
    <!-- The app's fonts, static Latin instances (SIL OFL 1.1, see Assets/Fonts/OFL.txt), compiled
         into the exe's resources: nothing ships beside it. -->
    <Resource Include="Assets\Fonts\*.ttf"/>
    <EmbeddedResource Include="Assets\payload.rmpk" Condition="Exists('Assets\payload.rmpk')"/>
    <!-- LZMA SDK + RMPK container, shared with the payload packer (see docs/desktop/packaging.md). -->
    <Compile Include="..\packaging\Shared\**\*.cs" LinkBase="Shared"/>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization"/>
    <Reference Include="Microsoft.CSharp"/>
  </ItemGroup>

</Project>
