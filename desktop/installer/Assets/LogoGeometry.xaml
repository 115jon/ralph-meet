<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Yappy, the Yap mark, on its 32-unit grid (branding/yappy-master.svg). -->

    <!-- The whole silhouette in the icon's pose (jaw open). -->
    <PathGeometry x:Key="LogoWhiteGeometry"
                  Figures="M2,0 L12,10 L21,10 L21,12 L32,12 L32,19 L21,19 L21,22 L28,22 L28,26 L18,26 L18,32 L4,32 L4,24 L2,24 Z"/>

    <!-- Ear, skull, snout and neck without the lower jaw; DitherMark adds the jaw per frame. -->
    <PathGeometry x:Key="LogoHeadGeometry"
                  Figures="M2,0 L12,10 L21,10 L21,12 L32,12 L32,19 L21,19 L21,24 L18,24 L18,32 L4,32 L4,24 L2,24 Z"/>

    <!-- Cut-outs: inner ear, eye and nose. -->
    <PathGeometry x:Key="LogoBlackGeometry"
                  Figures="M4,5 L8,9 L4,9 Z M13,13 L17,13 L17,17 L13,17 Z M29,12 L32,12 L32,15 L29,15 Z"/>

    <CombinedGeometry x:Key="LogoGeometry"
                      GeometryCombineMode="Exclude"
                      Geometry1="{StaticResource LogoWhiteGeometry}"
                      Geometry2="{StaticResource LogoBlackGeometry}"/>
</ResourceDictionary>
