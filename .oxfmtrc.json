{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "CHANGELOG.md",
    "coverage/**",
    "dist/**",
    ".output/**",
    ".tanstack/**",
    ".vinxi/**",
    ".wrangler/**",
    ".lighthouseci/**",
    "target-test/**",
    "public/mediapipe/**",
    "packages/*/dist/**",
    "src/routeTree.gen.ts",
    "pnpm-lock.yaml",
    "package-lock.json",
    "Cargo.lock",
    "*.lock",
    "**/*.toml",
    "desktop/src-tauri/**",
    "mobile/src-tauri/**",
    "src/components/ui/icon/glyphs.generated.ts",
    "src/lib/ytdlp/assets/*.min.js",
    "tools/oxlint/anti-slop/**"
  ]
}
